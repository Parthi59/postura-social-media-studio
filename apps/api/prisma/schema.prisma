generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id           String           @id @default(cuid())
  title        String
  source       String
  sourceType   String           @default("markdown")
  sourceUrl    String?
  status       String           @default("DRAFT")
  contentVersion Int            @default(1)
  approvedVersion Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  publications Publication[]
  events       ActivityEvent[]
  schedules    Schedule[]
  variants     CampaignVariant[]
  revisions    CampaignRevision[]
  reviewComments ReviewComment[]
  aiInsights     AiInsight[]
}

model Publication {
  id               String   @id @default(cuid())
  campaignId       String
  platform         String
  status           String   @default("PENDING")
  externalId       String?
  externalUrl      String?
  idempotencyKey   String   @unique
  httpStatus       Int?
  latencyMs        Int?
  errorMessage     String?
  attemptCount     Int      @default(1)
  retryAfterMs     Int?
  lastAttemptAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id         String   @id @default(cuid())
  campaignId String?
  type       String
  message    String
  metadata   String?
  createdAt  DateTime @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}


model Schedule {
  id            String    @id @default(cuid())
  campaignId    String
  platform      String    @default("discord")
  contentVersion Int       @default(1)
  scheduledAt   DateTime
  status        String    @default("SCHEDULED")
  executedAt    DateTime?
  publicationId String?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
}


model CampaignVariant {
  id         String   @id @default(cuid())
  campaignId String
  platform   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, platform])
}


model CampaignRevision {
  id              String   @id @default(cuid())
  campaignId      String
  version         Int
  discordContent  String
  mastodonContent String
  reason          String
  createdAt       DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([campaignId, createdAt])
}


model ReviewComment {
  id         String    @id @default(cuid())
  campaignId String
  version    Int
  author     String
  message    String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, version, resolved])
}


model AiInsight {
  id         String   @id @default(cuid())
  campaignId String
  version    Int
  provider   String
  model      String
  payload    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, version, createdAt])
}
